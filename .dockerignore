# Contexte de build : on n'envoie au daemon que le nécessaire.
# Un contexte plus petit = build plus rapide, et moins de risques
# de faire fuiter un fichier sensible dans l'image.

# Secrets locaux (la config arrive par variables d'environnement)
.env
.env.*

# Git et CI (sans effet sur le fonctionnement de l'image)
.git
.gitignore
.github
.gitattributes

# Caches et artefacts Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# Données de base locales (le compose utilise un volume nommé)
data/

# Fichiers non nécessaires à l'exécution
Dockerfile
docker-compose.yml
.dockerignore
README.md
EXAMEN.md
LICENSE
