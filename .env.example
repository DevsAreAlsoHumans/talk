# ---------------------------------------------------------------------------
# talk — variables d'environnement (EXEMPLE)
#
# Copier ce fichier vers « .env » puis adapter les valeurs :
#     cp .env.example .env
#
# Attention : le fichier « .env » est ignoré par git (ne jamais le committer).
# Ce fichier « .env.example » est un gabarit sans valeur réelle qui peut,
# lui, être commité.
# ---------------------------------------------------------------------------

# Clé secrète de l'application (signature des cookies de session).
# Générer une valeur aléatoire forte, par ex. :
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ Ne pas réutiliser la valeur d'exemple en production.
SECRET_KEY=change-me-generate-a-long-random-secret

# URL Redis (schéma redis://, mot de passe optionnel).
REDIS_URL=redis://localhost:6379/0

# Durée de vie d'une session en secondes (défaut : 7 jours).
SESSION_TTL=604800

# Nom du cookie de session.
COOKIE_NAME=session

# Cookie « Secure » : passer à true derrière HTTPS.
COOKIE_SECURE=false

# Rate-limit de connexion : nombre maximal d'échecs avant blocage.
MAX_LOGIN_ATTEMPTS=10

# Fenêtre (en secondes) du compteur de rate-limit.
RATE_LIMIT_WINDOW=900