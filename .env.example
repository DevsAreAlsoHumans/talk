# Copiez ce fichier en `.env` (jamais commité) pour personnaliser la configuration.
# docker compose lit automatiquement `.env`.

# Clé secrète du serveur (signature des jetons CSRF), 32 caractères minimum.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si elle est absente, une clé éphémère est générée à chaque démarrage (développement uniquement).
SECRET_KEY=

# Origines autorisées (séparées par des virgules) : celles depuis lesquelles le navigateur
# charge l'application. À adapter si vous n'utilisez pas http://localhost:8000.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cookies `Secure`. Chrome et Firefox l'acceptent sur http://localhost.
# Mettre `false` uniquement pour Safari ou un accès en HTTP sur un autre hôte (développement).
COOKIE_SECURE=true
